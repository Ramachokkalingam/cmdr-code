# Copy to .env and fill in real values. Never commit .env.

# Database
DATABASE_URL=postgresql://cmdr:password@localhost:5432/cmdr

# Firebase (backend / Admin SDK)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account-key.json

# Gemini — required, the AI router refuses to start without it
GOOGLE_API_KEY=your-google-api-key

# CORS: origins allowed to call this backend
ALLOWED_ORIGINS=["http://localhost:6969","http://localhost:3000"]

# Security — generate your own, e.g. `openssl rand -hex 32`
SECRET_KEY=change-me

# Debug
DEBUG=false
